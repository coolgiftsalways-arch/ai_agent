{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist-electron",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "./src/electron/**/*.ts",
    "./src/electron/**/*.cts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-electron",
    "dist-ui"
  ]
}