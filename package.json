{
  "name": "ai-agent-project",
  "version": "1.0.0",
  "description": "AI Agent powered by Ollama",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "ui": "vite --config vite.config.ts",
    "electron:build": "tsc -p tsconfig.electron.json",
    "electron:start": "npm run electron:build && wait-on http://localhost:5173 && electron .",
    "desktop": "concurrently -k \"npm run ui\" \"npm run electron:start\""
  },
  "keywords": [
    "ai",
    "agent",
    "ollama",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "googleapis": "^185.0.0",
    "gsap": "^3.15.0",
    "ollama": "^0.6.3",
    "playwright": "^1.64.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  }
}
